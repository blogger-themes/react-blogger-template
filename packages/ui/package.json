{
  "name": "@themes/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Deo Kumar",
    "email": "deo@fineshopdesign.com",
    "url": "https://github.com/kumardeo"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome lint ./src",
    "check": "biome check ./src",
    "check:types": "pnpm run check:app && pnpm run check:svelte",
    "check:app": "tsc --project ./tsconfig.app.json --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.svelte.json",
    "build": "pnpm run build:app && pnpm run build:svelte",
    "build:app": "NODE_ENV=production tsdown",
    "build:svelte": "NODE_ENV=production svelte-package --input src/svelte --output dist/svelte",
    "dev": "NODE_ENV=development tsdown --watch",
    "shadcn:react": "cp components.react.json components.json && pnpm dlx shadcn@latest",
    "shadcn:svelte": "cp components.svelte.json components.json && pnpm dlx shadcn-svelte@latest"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./index.css": "./dist/styles/index.css",
    ".": {
      "style": "./dist/styles/index.css",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/react/*.js"
    },
    "./svelte/shadcn/*": {
      "types": "./dist/svelte/shadcn/*/index.d.ts",
      "import": "./dist/svelte/shadcn/*/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    }
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "radix-ui": "^1.6.1",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/package": "^2.5.8",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn-svelte": "^1.3.0",
    "svelte": "catalog:",
    "svelte-check": "^4.7.1",
    "svelte-preprocess": "^6.0.5",
    "tsdown": "catalog:"
  }
}
